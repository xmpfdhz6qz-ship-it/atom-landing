<script>
// Animate progress bar on load
window.addEventListener('load', () => {
  setTimeout(() => {
    const fill = document.getElementById('progressFill');
    if (fill) fill.style.width = '100%';
  }, 400);
});

// Live store count
(async function() {
  try {
    const res = await fetch('https://n8n-production-1d7c.up.railway.app/webhook/stores', { headers: { 'Accept': 'application/json' } });
    const data = await res.json();
    const rows = Array.isArray(data) ? data : (data.stores || []);
    const count = rows.filter(r => r.domain || r.store_domain).length;
    if (count > 0) {
      const el = document.getElementById('storeCount');
      if (el) {
        let n = 0;
        const step = Math.ceil(count / 50);
        const timer = setInterval(() => {
          n = Math.min(n + step, count);
          el.textContent = n.toLocaleString('en-US');
          if (n >= count) clearInterval(timer);
        }, 30);
      }
    }
  } catch(e) {}
})();
</script>
