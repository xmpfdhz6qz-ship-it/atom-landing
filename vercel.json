{
  "rewrites": [
    {
      "source": "/scan/:id",
      "destination": "/report.html?id=:id"
    },
    {
      "source": "/store/:domain",
      "destination": "/store.html?domain=:domain"
    },
    {
      "source": "/report",
      "destination": "/report.html"
    },
    {
      "source": "/audit/:token",
      "destination": "/audit/index.html?token=:token"
    },
    {
      "source": "/audit-in-progress",
      "destination": "/audit-in-progress.html"
    },
    {
      "source": "/success",
      "destination": "/success/index.html"
    }
  ]
}
