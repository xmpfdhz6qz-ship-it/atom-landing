{
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "https://n8n-production-d989b.up.railway.app/webhook/sitemap"
    },

    {
      "src": "/scan/(.*)",
      "dest": "/report.html?id=$1"
    },
    {
      "src": "/store/(.*)",
      "dest": "/store.html?domain=$1"
    },
    {
      "src": "/report",
      "dest": "/report.html"
    },
    {
      "src": "/audit/(.*)",
      "dest": "/audit/index.html?token=$1"
    },
    {
      "src": "/audit-in-progress",
      "dest": "/audit-in-progress.html"
    },
    {
      "src": "/success",
      "dest": "/success/index.html"
    },
    {
      "src": "/thank-you",
      "dest": "/success/index.html"
    },

    {
      "src": "/monitoring/(.*)",
      "dest": "/monitoring.html"
    }
  ]
}
