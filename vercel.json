{
    "framework": null,
    "buildCommand": null,
    "outputDirectory": ".",
    "routes": [
          { "handle": "filesystem" },
          { "src": "/api/get-scan", "dest": "https://n8n-production-43ab.up.railway.app/webhook/get-scan" },
          { "src": "/ai/(.*)", "dest": "/_pages/ai/index.html" },
          { "src": "/sitemap.xml", "dest": "https://n8n-production-43ab.up.railway.app/webhook/sitemap" },
          { "src": "/methodology", "dest": "/methodology.html" },
          { "src": "/report/(.*)", "dest": "/report.html?token=$1" },
          { "src": "/store/(.*)", "dest": "/store.html?domain=$1" },
          { "src": "/audit/(.*)", "dest": "/audit/index.html?token=$1" },
          { "src": "/insight/(.*)", "dest": "/insight/index.html" },
          { "src": "/audit-processing", "dest": "/audit-processing/index.html" },
          { "src": "/audit-in-progress", "dest": "/audit-in-progress.html" }
    ]
}
