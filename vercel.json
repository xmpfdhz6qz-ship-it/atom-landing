{
  "rewrites": [
    {
      "source": "/scan/:id",
      "destination": "/report.html?id=:id"
    },
    {
      "source": "/store/:domain",
      "destination": "/store.html?domain=:domain"
    },
    {
      "source": "/report",
      "destination": "/report.html"
    },
    {
      "source": "/audit/:token",
      "destination": "/audit/index.html?token=:token"
    },
    {
      "source": "/thank-you",
      "destination": "/success"
    },
    {
      "source": "/after_payment_399_page",
      "destination": "/after_payment_399_page.html"
    }
  ]
}
