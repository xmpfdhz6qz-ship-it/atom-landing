{
  "rewrites": [
    {
      "source": "/api/get-scan",
      "destination": "https://n8n-production-43ab.up.railway.app/webhook/get-scan"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://n8n-production-43ab.up.railway.app/webhook/sitemap"
    },
    {
      "source": "/report/(.*)",
      "destination": "/report.html?token=$1"
    },
    {
      "source": "/store/(.*)",
      "destination": "/store.html?domain=$1"
    },
    {
      "source": "/audit/(.*)",
      "destination": "/audit/index.html?token=$1"
    },
    {
      "source": "/audit-in-progress",
      "destination": "/audit-in-progress.html"
    },
    {
      "source": "/success",
      "destination": "/success/index.html"
    },
    {
      "source": "/thank-you",
      "destination": "/success/index.html"
    },
    {
      "source": "/monitoring-info",
      "destination": "/monitoring/index.html"
    },
    {
      "source": "/monitoring/(.*)",
      "destination": "/monitoring.html"
    },
    {
      "source": "/monitoring-report/(.*)",
      "destination": "/monitoring-report.html?token=$1"
    }
  ]
}
